    "inherited": [
      "child",
      "parent",
      "father",
      "mother",
      "relative"
    ],
    "intimate_partnership": [
      "spouse",
      "partner"
    ],
    "education_mentorship": [
      "doctoralAdvisor",
      "doctoralStudent",
      "academicAdvisor",
      "notableStudent",
      "trainer",
      "training",
      "coach"
    ],
    "professional_collaboration": [
      "associate",
      "employer"
    ],
    "influence": [
      "influenced",
      "influencedBy"
    ],
    "succession": [
      "successor",
      "predecessor"
    ],
    "religious_authority_recognition": [
      "beatifiedBy",
      "canonizedBy"
    ],
    "other_acquired": [
      "president",
      "primeMinister",
      "governor",
      "governorGeneral",
      "monarch",
      "chancellor",
      "lieutenant",
      "vicePresident",
