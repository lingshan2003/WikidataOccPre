{
  "name": "cbdb_period_rgcn_graphmask_v1",
  "version": 1,
  "flat_input": "CBDB/data/person_relation_triples.tsv.gz",
  "database": "external_data/cbdb/2026.09.14/cbdb_20260914.sqlite3",
  "occupation_rules": "config/cbdb_occupation_whitelist_v1.json",
  "relation_profile": "config/cbdb_experiment_relation_groups_v1.json",
  "period_config": "config/cbdb_periods_v1.json",
  "output_root": "artifacts/cbdb_pipeline_v1",
  "representations": ["multi_group", "binary"],
  "seeds": [42],
  "device": "cuda:0",
  "prepare": {
    "target_level": 1,
    "min_class_count": 3,
    "train_ratio": 0.7,
    "val_ratio": 0.1,
    "test_ratio": 0.2,
    "seed": 20261006
  },
  "num_bases": {"multi_group": 14, "binary": 4},
  "train": {
    "model": "rgcn",
    "epochs": 50,
    "train_mode": "sampled",
    "eval_mode": "sampled",
    "batch_size": 512,
    "num_layers": 2,
    "num_neighbors": "15,10",
    "hidden_dim": 128,
    "branch_dim": 64,
    "rgcn_backend": "fast",
    "dropout": 0.2,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "early_stop_metric": "macro_f1",
    "min_delta": 0.001,
    "patience": 6,
    "num_workers": 4,
    "occupation_feature_levels": "1",
    "auxiliary_features": "temporal"
  },
  "graphmask_train": {
    "num_neighbors": "auto",
    "batch_size": 32,
    "num_workers": 0,
    "epochs_per_layer": 3,
    "beta": 0.03,
    "learning_rate": 0.0001,
    "multiplier_learning_rate": 0.01,
    "temperature": 0.3333333333333333,
    "location_bias": 3.0,
    "max_relative_macro_f1_diff": 0.05,
    "train_split": "train",
    "validation_split": "val"
  },
  "graphmask_report": {
    "split": "test",
    "num_neighbors": "auto",
    "top_k": 50
  }
}
