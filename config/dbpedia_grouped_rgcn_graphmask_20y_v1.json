{
  "name": "dbpedia_grouped_rgcn_graphmask_20y_v1",
  "version": 1,
  "source_data": "artifacts/dbpedia_2022_priority_v1/graph_data.pt",
  "period_root": "artifacts/dbpedia_2022_priority_periods_20y_v1",
  "period_config": "config/dbpedia_life_periods_20y_v1.json",
  "binary_taxonomy": "config/dbpedia_tie_taxonomy_v1.json",
  "multi_group_taxonomy": "config/dbpedia_tie_taxonomy_acquired_subgroups_v1.json",
  "relation_root": "artifacts/dbpedia_grouped_20y_v1",
  "model_root": "runs/dbpedia_grouped_20y_v1",
  "graphmask_root": "runs_graphmask/dbpedia_grouped_20y_v1",
  "periods": "all",
  "representations": ["binary", "multi_group"],
  "include_full": false,
  "seed": 42,
  "device": "cuda:0",
  "prepare": {
    "split_seed": 20260814,
    "train_ratio": 0.7,
    "val_ratio": 0.1,
    "test_ratio": 0.2,
    "local_min_class_count": 3
  },
  "num_bases": {"binary": 4, "multi_group": 14},
  "train": {
    "model": "rgcn",
    "epochs": 50,
    "train_mode": "sampled",
    "eval_mode": "sampled",
    "batch_size": 512,
    "num_layers": 2,
    "num_neighbors": "15,10",
    "hidden_dim": 128,
    "branch_dim": 64,
    "rgcn_backend": "fast",
    "dropout": 0.2,
    "lr": 0.001,
    "weight_decay": 0.0001,
    "early_stop_metric": "macro_f1",
    "min_delta": 0.001,
    "patience": 6,
    "num_workers": 4,
    "occupation_feature_levels": "1",
    "auxiliary_features": "temporal"
  },
  "graphmask_train": {
    "num_neighbors": "auto",
    "batch_size": 32,
    "num_workers": 0,
    "epochs_per_layer": 3,
    "beta": 0.03,
    "learning_rate": 0.0001,
    "multiplier_learning_rate": 0.01,
    "temperature": 0.3333333333333333,
    "location_bias": 3.0,
    "max_relative_macro_f1_diff": 0.05,
    "train_split": "train",
    "validation_split": "val"
  },
  "graphmask_report": {
    "split": "test",
    "num_neighbors": "auto",
    "top_k": 50
  }
}
